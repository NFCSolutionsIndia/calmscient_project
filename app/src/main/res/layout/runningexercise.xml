<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".activities.DancingExercisesActivity"
    tools:ignore="MissingDefaultResource"
    android:layout_marginBottom="@dimen/_58sdp">

    <RelativeLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_10sdp">

        <ImageView
            android:id="@+id/menuicon"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/runningexercise_titletext"
            android:textColor="@color/black_head"
            android:textSize="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/lexendmedium" />

    </RelativeLayout>
    <View
        android:id="@+id/view1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/viewbackgroundcolor"
        android:layout_below="@+id/toolBar"/>
    <LinearLayout
        android:id="@+id/contentText1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/view1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/runningexercises_image"/>
            <ImageView
                android:id="@+id/favoritesIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_250sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:clickable="true"
                android:src="@drawable/mindfullexercise_heart__image"/>
        </RelativeLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_40sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:text="@string/runningexercises_text"
            android:fontFamily="@font/lexendlight"
            android:textColor="@color/black_head"
            android:textSize="@dimen/_12sdp"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/completeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:background="@drawable/complete_button_background"
            android:fontFamily="@font/lexendregular"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:text="@string/complete"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:visibility="visible"/>
    </RelativeLayout>

</RelativeLayout>
